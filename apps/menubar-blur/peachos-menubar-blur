#!/usr/bin/env python3
"""Generates the blurred wallpaper strip shown behind the peachOS menu bar when
"Background Blur" is on (macos-top-panel@local.dev, lib/panelBackground.js).

GPU-free on purpose -- Shell.BlurEffect / blur-my-shell's live panel blur is a real
freeze risk on the weak GPUs peachOS still targets. This software-blurs just the slice
of the wallpaper that sits behind the panel, regenerated only when the wallpaper, the
light/dark scheme or the monitor geometry changes.

Usage: peachos-menubar-blur <monitor_w> <monitor_h> <panel_h> [out_path]  (device px)
Prints the path of the PNG it wrote.
"""
import os
import sys

import gi
gi.require_version('Gio', '2.0')
from gi.repository import Gio  # noqa: E402
from PIL import Image, ImageEnhance, ImageFilter  # noqa: E402

OUT_DIR = os.path.join(
    os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache'),
    'peachos-menubar',
)


def _cover_crop(im, w, h):
    src = im.width / im.height
    tgt = w / h
    if src > tgt:
        nw = round(im.height * tgt)
        x0 = (im.width - nw) // 2
        im = im.crop((x0, 0, x0 + nw, im.height))
    else:
        nh = round(im.width / tgt)
        y0 = (im.height - nh) // 2
        im = im.crop((0, y0, im.width, y0 + nh))
    return im.resize((w, h), Image.LANCZOS)


def main():
    if len(sys.argv) not in (4, 5):
        print(__doc__, file=sys.stderr)
        return 2
    mon_w, mon_h, panel_h = (max(1, int(a)) for a in sys.argv[1:4])
    out_path = sys.argv[4] if len(sys.argv) == 5 else None

    bg = Gio.Settings.new('org.gnome.desktop.background')
    iface = Gio.Settings.new('org.gnome.desktop.interface')
    dark = iface.get_string('color-scheme') == 'prefer-dark'
    uri = (bg.get_string('picture-uri-dark') if dark else '') or bg.get_string('picture-uri')
    if not uri:
        return 1
    path = Gio.File.new_for_uri(uri).get_path()
    if not path or not os.path.isfile(path):
        return 1

    im = Image.open(path).convert('RGB')
    im = _cover_crop(im, mon_w, mon_h)                      # what this monitor shows
    strip = im.crop((0, 0, mon_w, min(panel_h, mon_h)))    # the bit behind the panel

    strip = strip.filter(ImageFilter.GaussianBlur(max(8, panel_h * 0.7)))
    strip = ImageEnhance.Brightness(strip).enhance(0.80 if dark else 1.08)
    strip = ImageEnhance.Color(strip).enhance(1.05)
    scrim = Image.new('RGB', strip.size, (10, 10, 12) if dark else (250, 250, 252))
    strip = Image.blend(strip, scrim, 0.22)

    if out_path:
        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        target = out_path
    else:
        os.makedirs(OUT_DIR, exist_ok=True)
        target = os.path.join(OUT_DIR, f'panel-blur-{"dark" if dark else "light"}.png')
    strip.save(target)
    print(target)
    return 0


if __name__ == '__main__':
    sys.exit(main())
