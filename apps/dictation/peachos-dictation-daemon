#!/usr/bin/env python3
"""Peach Intelligence dictation daemon.

Runs as a per-user systemd service (peachos-dictation-daemon.service), owning everything
that DOESN'T need to live inside gnome-shell's own process: recording, offline speech-to-text
(whisper.cpp), the optional LLM cleanup pass, and the clipboard. The GNOME Shell side
(extensions/peachos-dictation@peachos) owns the global hotkey (press to start, hold, release
to stop -- see that extension's own docstring for why detecting release needs to happen
in-process) and the final paste keystroke (also has to happen in-process -- confirmed live on
this machine, a plain Wayland client can't inject synthetic input at all: `wtype` fails with
"Compositor does not support the virtual keyboard protocol"). The two talk over D-Bus: this
process exports org.peachos.DictationDaemon (StartRecording/StopRecording, called BY the
extension), and calls back into the extension's own org.peachos.Dictation (Paste/Failed) once
a transcript is ready.

Dictation itself never needs an API key -- whisper.cpp runs fully offline. An API key
(Settings app's Peach Intelligence tab, stored in the login keyring via libsecret, never in
gsettings/plaintext) only ever does one optional thing: a cleanup pass over the raw
transcript (punctuation, grammar, filler words) via Anthropic or OpenAI, gated by the
cleanup-enabled gsetting. No API key configured (or cleanup disabled) means the raw
whisper.cpp transcript gets pasted exactly as heard.
"""
import array
import json
import math
import os
import signal
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import wave
from pathlib import Path

import gi

gi.require_version('GLib', '2.0')
gi.require_version('Gio', '2.0')
gi.require_version('Secret', '1')
from gi.repository import Gio, GLib, Secret
from pydbus import SessionBus
# Name clash with the stdlib `signal` module (signal.SIGINT, already used below) --
# pydbus's own signal descriptor is aliased rather than the far more common stdlib one.
from pydbus.generic import signal as dbus_signal

WHISPER_BIN = '/usr/lib/peachos/dictation/whisper-cli'
WHISPER_MODEL = '/usr/share/peachos/whisper/ggml-base.en.bin'
# whisper-cli links against libwhisper/libggml*, built fresh by provision.sh (no distro
# package ships them) and installed alongside it here rather than into a system libdir --
# confirmed live: the binary's own baked-in RUNPATH pointed at the build tree and broke the
# moment that directory was gone, so this is set explicitly on every invocation instead of
# relying on any RUNPATH/ldconfig at all.
WHISPER_LIB_DIR = '/usr/lib/peachos/dictation/lib'
# Light vocabulary bias, not a hard rule -- whisper.cpp's --prompt just nudges recognition
# toward these tokens when the audio is ambiguous (this is what fixed "beach OS" -> "PeachOS"
# during testing). Kept short: whisper.cpp caps the initial prompt at n_text_ctx/2 tokens.
WHISPER_PROMPT = 'peachOS, Peach Intelligence, Sidra, Orchard'
WHISPER_TIMEOUT_SECONDS = 120

SETTINGS_SCHEMA_ID = 'org.gnome.shell.extensions.peachos-dictation'

SECRET_SCHEMA = Secret.Schema.new(
    'org.peachos.dictation.ApiKey', Secret.SchemaFlags.NONE,
    {'provider': Secret.SchemaAttributeType.STRING},
)

EXT_BUS_NAME = 'org.peachos.Dictation'
EXT_OBJECT_PATH = '/org/peachos/Dictation'

CLEANUP_PROMPT = (
    'You clean up dictated speech-to-text. Fix punctuation, capitalization, and grammar; '
    'remove filler words (um, uh, like) and false starts; keep the original meaning and '
    'wording otherwise. Reply with ONLY the cleaned-up text, nothing else -- no preamble, '
    'no quotes around it.'
)
ANTHROPIC_MODEL = 'claude-haiku-4-5-20251001'
OPENAI_MODEL = 'gpt-4o-mini'

# Recent-transcriptions dropdown (macos-top-panel@local.dev's lib/dictationHistoryIndicator.js
# reads this same path -- only ever reads it, this daemon is the only writer). Newest first;
# capped well past the 3 the dropdown actually shows so there's a little slack if that number
# ever changes without needing to touch this side too.
HISTORY_PATH = Path.home() / '.local/share/peachos/dictation-history.json'
HISTORY_MAX_ENTRIES = 10

SAMPLE_RATE = 16000
# How often Level actually gets emitted, independent of how fast pw-record's pipe delivers
# chunks (PipeWire's own --latency, ~100ms default, roughly sets that already, but this caps
# it regardless): ~12/sec is plenty smooth for a waveform once the Dynamic Island eases
# between values, and doesn't spam D-Bus.
LEVEL_EMIT_INTERVAL_S = 0.08
# RMS-to-0..1 mapping. Measured live on this machine (silence, no one talking): RMS sits
# around 2300-3000 at steady state, apparently real ambient/mic-gain noise, not a bug -- a
# genuine "quiet room" floor here is much hotter than a properly-calibrated mic would read.
# Both numbers below are set with real headroom above that, but NOT validated against actual
# speech (nothing in this environment can generate real spoken audio to test with) -- if the
# waveform pegs at max regardless of how loud you're actually talking, LEVEL_RMS_REFERENCE
# needs to go higher; if it barely moves, lower it. The <1 exponent (a gamma curve, same idea
# a real VU meter uses) lifts quiet speech into visible range without letting loud speech peg
# at max the whole time.
LEVEL_RMS_REFERENCE = 18000.0
LEVEL_GAMMA = 0.6
# Below this RMS, treat it as room/mic-gain noise floor and report exactly 0 -- otherwise the
# waveform visibly jitters while the user isn't actually talking, which reads as broken. Set
# above the ~2300-3000 measured silence floor with margin, not right at it.
LEVEL_NOISE_FLOOR_RMS = 4000.0
# Opening the audio stream produces a real, brief pop/click transient (measured live: chunks
# for roughly the first third of a second after StartRecording read far hotter, sometimes
# near-clipping, than anything that follows) -- not a signal worth showing as a fake
# "shouting" spike right when the pill first appears. Time-based, not chunk-count-based: an
# earlier chunk-count version undershot badly because pw-record's actual chunk-arrival rate
# didn't match the ~0.128s/4096-byte-chunk assumption it was based on (measured live: the
# transient was still showing at the 3rd *emitted* signal, well past 3 raw chunks in).
LEVEL_WARMUP_SECONDS = 0.45


class DictationDaemon:
    """
    <node>
      <interface name='org.peachos.DictationDaemon'>
        <method name='StartRecording' />
        <method name='StopRecording' />
        <signal name='Level'>
          <arg type='d' name='level' />
        </signal>
      </interface>
    </node>
    """
    # Emitted at LEVEL_EMIT_INTERVAL_S while (and only while) actually recording, so the
    # Dynamic Island can draw a waveform driven by real microphone amplitude instead of a
    # canned animation -- see _emit_level()'s own docstring for the actual math.
    Level = dbus_signal()

    def __init__(self):
        self._settings = Gio.Settings.new(SETTINGS_SCHEMA_ID)
        self._proc = None
        self._audio_watch_id = 0
        self._pcm_chunks = []
        self._last_level_emit = 0.0
        self._record_start_time = 0.0
        self._session_bus = SessionBus()

    # ---- D-Bus methods, called by the extension on hotkey press/release ----

    def StartRecording(self):
        if self._proc is not None:
            return  # a stray duplicate press while already recording -- ignore, not an error
        self._pcm_chunks = []
        self._last_level_emit = 0.0
        self._record_start_time = time.monotonic()
        try:
            # --container raw: headerless s16 mono PCM straight to stdout -- confirmed live
            # (checked the actual bytes) that '--container raw -' really does skip any WAV/
            # RIFF header, unlike writing to a plain .wav path. Read directly here (rather
            # than pw-record writing a file we only reopen afterward) is what makes live
            # level metering possible at all; StopRecording builds the real WAV file itself
            # from the buffered bytes once recording ends.
            self._proc = subprocess.Popen(
                ['pw-record', '--rate', str(SAMPLE_RATE), '--channels', '1', '--format', 's16',
                 '--container', 'raw', '-'],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            )
        except OSError as e:
            self._proc = None
            self._notify_extension('Failed', f'Could not start recording: {e}')
            return

        os.set_blocking(self._proc.stdout.fileno(), False)
        self._audio_watch_id = GLib.io_add_watch(
            self._proc.stdout.fileno(), GLib.PRIORITY_DEFAULT,
            GLib.IOCondition.IN | GLib.IOCondition.HUP, self._on_audio_readable)

    def _on_audio_readable(self, fd, condition):
        if condition & GLib.IOCondition.HUP and not (condition & GLib.IOCondition.IN):
            self._audio_watch_id = 0
            return GLib.SOURCE_REMOVE
        try:
            chunk = os.read(fd, 4096)
        except BlockingIOError:
            return GLib.SOURCE_CONTINUE
        except OSError:
            self._audio_watch_id = 0
            return GLib.SOURCE_REMOVE
        if not chunk:
            self._audio_watch_id = 0
            return GLib.SOURCE_REMOVE

        self._pcm_chunks.append(chunk)
        now = time.monotonic()
        past_warmup = now - self._record_start_time >= LEVEL_WARMUP_SECONDS
        if past_warmup and now - self._last_level_emit >= LEVEL_EMIT_INTERVAL_S:
            self._last_level_emit = now
            self._emit_level(chunk)
        return GLib.SOURCE_CONTINUE

    def _emit_level(self, chunk):
        """One chunk's RMS, gamma-curved into 0..1 and emitted as Level. Doesn't accumulate
        across chunks between emits -- a single ~0.08s-old chunk is representative enough for
        a waveform bar, and skipping the ones in between is what keeps this cheap."""
        usable_len = len(chunk) - (len(chunk) % 2)
        if usable_len <= 0:
            return
        samples = array.array('h')
        samples.frombytes(chunk[:usable_len])
        if not samples:
            return

        rms = math.sqrt(sum(s * s for s in samples) / len(samples))
        if rms < LEVEL_NOISE_FLOOR_RMS:
            self.Level(0.0)
            return
        level = min(1.0, (rms / LEVEL_RMS_REFERENCE) ** LEVEL_GAMMA)
        self.Level(level)

    def StopRecording(self):
        if self._proc is None:
            return
        proc = self._proc
        self._proc = None
        if self._audio_watch_id:
            GLib.source_remove(self._audio_watch_id)
            self._audio_watch_id = 0

        # SIGINT (not SIGKILL/terminate) -- pw-record flushes cleanly on a clean interrupt;
        # killing it outright risks losing whatever's still in its own internal buffer.
        proc.send_signal(signal.SIGINT)
        try:
            proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            proc.kill()

        # One last synchronous drain: the IO watch only runs the pipe empty on the main
        # loop's own schedule, so a final chunk written right as pw-record exits can still be
        # sitting unread in the pipe. The writer is gone by now (proc.wait() above already
        # returned), so a blocking read here just returns whatever's left, immediately.
        try:
            os.set_blocking(proc.stdout.fileno(), True)
            remainder = proc.stdout.read()
            if remainder:
                self._pcm_chunks.append(remainder)
        except (OSError, ValueError):
            pass

        pcm_bytes = b''.join(self._pcm_chunks)
        self._pcm_chunks = []

        fd, wav_path = tempfile.mkstemp(prefix='peachos-dictation-', suffix='.wav')
        os.close(fd)
        with wave.open(wav_path, 'wb') as wav_file:
            wav_file.setnchannels(1)
            wav_file.setsampwidth(2)  # s16
            wav_file.setframerate(SAMPLE_RATE)
            wav_file.writeframes(pcm_bytes)

        # Returns to the D-Bus caller (the extension) immediately -- the actual transcription
        # work happens on the next main-loop iteration, so a slow whisper.cpp run never makes
        # the extension's StopRecording call_sync() hang.
        GLib.idle_add(self._process, wav_path)

    # ---- The actual work, off the D-Bus call path ---------------------------

    def _process(self, wav_path):
        try:
            text = self._run_whisper(wav_path)
            if not text:
                self._notify_extension('Failed', 'No speech detected')
                return GLib.SOURCE_REMOVE
            text = self._maybe_clean_up(text)
            self._set_clipboard(text)
            self._save_history(text)
            self._notify_extension('Paste')
        except subprocess.TimeoutExpired:
            self._notify_extension('Failed', 'Transcription timed out')
        except Exception as e:  # noqa: BLE001 -- always report back to the indicator, never
            self._notify_extension('Failed', str(e))  # crash the daemon over one bad clip
        finally:
            try:
                os.unlink(wav_path)
            except OSError:
                pass
        return GLib.SOURCE_REMOVE

    def _run_whisper(self, wav_path):
        env = {**os.environ, 'LD_LIBRARY_PATH': WHISPER_LIB_DIR}
        result = subprocess.run(
            [
                WHISPER_BIN, '-m', WHISPER_MODEL, '-f', wav_path,
                '-nt', '-np', '-l', 'en', '--prompt', WHISPER_PROMPT,
            ],
            capture_output=True, text=True, timeout=WHISPER_TIMEOUT_SECONDS, env=env,
        )
        return result.stdout.strip()

    def _maybe_clean_up(self, raw_text):
        if not self._settings.get_boolean('cleanup-enabled'):
            return raw_text
        provider = self._settings.get_string('cleanup-provider')
        try:
            api_key = Secret.password_lookup_sync(SECRET_SCHEMA, {'provider': provider}, None)
        except GLib.Error:
            api_key = None
        if not api_key:
            return raw_text  # cleanup wanted but no key configured -- fall back silently
        try:
            if provider == 'anthropic':
                cleaned = self._cleanup_anthropic(raw_text, api_key)
            elif provider == 'openai':
                cleaned = self._cleanup_openai(raw_text, api_key)
            else:
                cleaned = None
        except (urllib.error.URLError, TimeoutError, ValueError, KeyError):
            cleaned = None  # network hiccup / bad response -- paste the raw transcript instead
        return cleaned or raw_text

    def _cleanup_anthropic(self, text, api_key):
        body = json.dumps({
            'model': ANTHROPIC_MODEL,
            'max_tokens': 1024,
            'system': CLEANUP_PROMPT,
            'messages': [{'role': 'user', 'content': text}],
        }).encode('utf-8')
        req = urllib.request.Request(
            'https://api.anthropic.com/v1/messages', data=body, method='POST',
            headers={
                'x-api-key': api_key,
                'anthropic-version': '2023-06-01',
                'content-type': 'application/json',
            },
        )
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.load(resp)
        parts = data.get('content', [])
        text = ''.join(p.get('text', '') for p in parts if p.get('type') == 'text').strip()
        return text or None

    def _cleanup_openai(self, text, api_key):
        body = json.dumps({
            'model': OPENAI_MODEL,
            'messages': [
                {'role': 'system', 'content': CLEANUP_PROMPT},
                {'role': 'user', 'content': text},
            ],
        }).encode('utf-8')
        req = urllib.request.Request(
            'https://api.openai.com/v1/chat/completions', data=body, method='POST',
            headers={'Authorization': f'Bearer {api_key}', 'content-type': 'application/json'},
        )
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.load(resp)
        text = data['choices'][0]['message']['content'].strip()
        return text or None

    def _set_clipboard(self, text):
        subprocess.run(['wl-copy'], input=text.encode('utf-8'), check=False)

    def _save_history(self, text):
        try:
            history = json.loads(HISTORY_PATH.read_text(encoding='utf-8'))
            if not isinstance(history, list):
                history = []
        except (OSError, ValueError):
            history = []

        history.insert(0, {'text': text, 'timestamp': time.time()})
        history = history[:HISTORY_MAX_ENTRIES]

        try:
            HISTORY_PATH.parent.mkdir(parents=True, exist_ok=True)
            tmp_path = HISTORY_PATH.with_suffix(f'.tmp-{os.getpid()}')
            tmp_path.write_text(json.dumps(history), encoding='utf-8')
            tmp_path.rename(HISTORY_PATH)  # atomic -- the indicator never reads a torn file
        except OSError:
            pass  # history is a nice-to-have -- losing an entry isn't worth failing the paste

    def _notify_extension(self, method, *args):
        try:
            ext = self._session_bus.get(EXT_BUS_NAME, EXT_OBJECT_PATH)
            getattr(ext, method)(*args)
        except GLib.Error:
            pass  # extension not loaded/running -- nothing more this daemon can do


def main():
    bus = SessionBus()
    bus.publish('org.peachos.DictationDaemon', DictationDaemon())
    GLib.MainLoop().run()


if __name__ == '__main__':
    main()
