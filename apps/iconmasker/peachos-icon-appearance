#!/usr/bin/env python3
"""Apply or revert peachOS's icon-appearance mode, for the current user.

Usage: peachos-icon-appearance <default|dark|clear>

Runs unprivileged, as a plain user-session tool (no pkexec, no root) --
icon appearance is a personal preference, not a system policy, so it's
implemented as XDG user-level overrides:

  ~/.local/share/applications/<id>.desktop     (full copy of the system
                                                 .desktop, only Icon= changed)
  ~/.local/share/icons/peachos-<style>/*.png   (the generated/curated PNGs)

XDG desktop-file resolution already gives a user's own ~/.local/share
directory priority over /usr/share, so this needs zero coordination with
peachos-icon-watcherd (the system-wide light-mode masking daemon) beyond
peachos_icon_resolve.py knowing to leave these directories alone -- and
critically, the system .desktop files themselves are never touched, which
is what actually caused the real bugs the previous (system-wide, root)
version of this hit: fighting the watcher daemon over the same files, and
GNOME Shell's app-picker-layout state getting corrupted by the resulting
burst of changes to files it watches closely.

'default' mode is just deleting our own override files -- instant, no
image processing needed, since it makes the original system .desktop
(which peachos-icon-watcherd keeps correctly light-mode-masked) visible
again automatically. Switching directly between two non-default styles
(e.g. dark -> clear) needs no separate "clear old style" step either --
every candidate's override file is fully regenerated and overwritten each
run, it just points at a freshly generated PNG under a different style
subdirectory.
"""
import concurrent.futures
import glob
import hashlib
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from peachos_icon_clear import apply_clear_mode
from peachos_icon_dark import apply_dark_mode, is_already_dark
from peachos_icon_mask import load_pixbuf_as_pil
from peachos_icon_resolve import resolve_icon, resolve_curated_dark

SYSTEM_DIRS = ['/usr/share/applications', '/var/lib/snapd/desktop/applications']

USER_APPS_DIR = Path.home() / '.local/share/applications'
USER_ICON_DIR = Path.home() / '.local/share/icons'

ICON_LINE_RE = re.compile(r'^Icon=(.*)$')
OVERRIDE_MARKER = 'X-PeachOS-AppearanceOverride=true\n'
LEGACY_OVERRIDE_MARKER = 'X-PeachOS-DarkOverride=true\n'  # pre-'clear' marker, still on disk
MAX_WORKERS = 8


def slug_for(desktop_path):
    stem = re.sub(r'[^A-Za-z0-9_.-]', '_', Path(desktop_path).stem)
    digest = hashlib.sha1(str(desktop_path).encode()).hexdigest()[:8]
    return f'{stem}-{digest}'


def read_meta(desktop_path):
    icon = None
    is_application = False
    no_display = False
    try:
        text = Path(desktop_path).read_text(encoding='utf-8', errors='replace')
    except OSError:
        return None, False, False
    in_entry = False
    for line in text.splitlines():
        if line == '[Desktop Entry]':
            in_entry = True
            continue
        if line.startswith('[') and line != '[Desktop Entry]':
            if in_entry:
                break
            continue
        if not in_entry:
            continue
        if line.startswith('Type=Application'):
            is_application = True
        elif line.startswith('NoDisplay=true'):
            no_display = True
        elif (m := ICON_LINE_RE.match(line)) and icon is None:
            icon = m.group(1).strip()
    return icon, is_application, no_display


def _make_icon(style, icon_dir, desktop_path, icon):
    """Runs in a worker thread: resolve + generate the PNG for the given
    style. No filesystem writes to the .desktop file here -- that happens
    back on the main thread, once all the (slow, parallel) image work is
    done."""
    source_path, _category = resolve_icon(icon)
    if source_path is None:
        return None, f'could not resolve icon {icon!r}'

    out_path = icon_dir / f'{slug_for(desktop_path)}.png'
    try:
        if style == 'dark':
            curated_dark_source = resolve_curated_dark(source_path)
            if curated_dark_source is not None:
                img = load_pixbuf_as_pil(str(curated_dark_source))
                img.save(out_path, 'PNG')
                return out_path, 'curated'
            img = load_pixbuf_as_pil(str(source_path))
            if is_already_dark(img):
                return None, None  # already reads fine in dark mode, nothing to do
            apply_dark_mode(img, out_path)
            return out_path, 'generated'

        img = load_pixbuf_as_pil(str(source_path))
        apply_clear_mode(img, out_path)
        return out_path, 'generated'
    except Exception as e:
        return None, str(e)


def _write_override(desktop_path, out_path):
    try:
        lines = desktop_path.read_text(encoding='utf-8', errors='replace').splitlines(keepends=True)
    except OSError as e:
        return f'could not read {desktop_path}: {e}'

    replaced = False
    in_entry = False
    entry_end = len(lines)
    for i, line in enumerate(lines):
        stripped = line.rstrip('\n')
        if stripped == '[Desktop Entry]':
            in_entry = True
            continue
        if stripped.startswith('[') and stripped != '[Desktop Entry]':
            if in_entry:
                entry_end = i
                break
            continue
        if in_entry and ICON_LINE_RE.match(stripped):
            lines[i] = f'Icon={out_path}\n'
            replaced = True
    if not replaced:
        return f'no Icon= line in {desktop_path}'
    lines.insert(entry_end, OVERRIDE_MARKER)

    USER_APPS_DIR.mkdir(parents=True, exist_ok=True)
    (USER_APPS_DIR / desktop_path.name).write_text(''.join(lines), encoding='utf-8')
    return None


def apply_style(style):
    icon_dir = USER_ICON_DIR / f'peachos-{style}'
    icon_dir.mkdir(parents=True, exist_ok=True)
    USER_APPS_DIR.mkdir(parents=True, exist_ok=True)

    # SYSTEM_DIRS is in priority order (matches $XDG_DATA_DIRS): a desktop ID present in more
    # than one dir -- e.g. firefox_firefox.desktop and snap-store_snap-store.desktop exist
    # both as peachOS's own /usr/share/applications override AND as the original snapd-managed
    # copy they shadow at /var/lib/snapd/desktop/applications -- must only ever be processed
    # from its highest-priority (first-seen) location. Processing both independently used to
    # race two threads against the same output filename, and whichever happened to finish
    # last silently won -- sometimes the shadowed original, producing the wrong icon.
    seen_names = set()
    candidates = []
    for d in SYSTEM_DIRS:
        for desktop_path in Path(d).glob('*.desktop'):
            if desktop_path.name in seen_names:
                continue
            seen_names.add(desktop_path.name)
            icon, is_app, no_display = read_meta(desktop_path)
            if not is_app or no_display or not icon:
                continue
            candidates.append((desktop_path, icon))

    with concurrent.futures.ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool:
        futures = {
            pool.submit(_make_icon, style, icon_dir, dp, icon): (dp, icon)
            for dp, icon in candidates
        }
        for future in concurrent.futures.as_completed(futures):
            desktop_path, icon = futures[future]
            out_path, status = future.result()
            if out_path is None:
                if status:
                    print(f'  ! {desktop_path.name}: {status}')
                continue
            err = _write_override(desktop_path, out_path)
            if err:
                print(f'  ! {desktop_path.name}: {err}')
            else:
                print(f'  {style}({status}) {desktop_path.name} -> {out_path}')

    subprocess.run(['update-desktop-database', str(USER_APPS_DIR)], check=False)


def apply_default():
    if not USER_APPS_DIR.is_dir():
        return
    removed = 0
    for f in USER_APPS_DIR.glob('*.desktop'):
        try:
            text = f.read_text(encoding='utf-8', errors='replace')
            if OVERRIDE_MARKER.strip() in text or LEGACY_OVERRIDE_MARKER.strip() in text:
                f.unlink()
                removed += 1
        except OSError:
            continue
    if removed:
        print(f'  removed {removed} icon-appearance override(s)')
    subprocess.run(['update-desktop-database', str(USER_APPS_DIR)], check=False)


def main():
    styles = ('default', 'dark', 'clear')
    if len(sys.argv) != 2 or sys.argv[1] not in styles:
        print(f'usage: peachos-icon-appearance <{"|".join(styles)}>', file=sys.stderr)
        sys.exit(1)

    style = sys.argv[1]
    if style == 'default':
        apply_default()
    else:
        apply_style(style)


if __name__ == '__main__':
    main()
