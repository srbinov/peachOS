#!/usr/bin/env python3
"""Apply or revert peachOS's icon-appearance mode, for the current user.

Usage: peachos-icon-appearance <default|dark|custom>

Runs unprivileged, as a plain user-session tool (no pkexec, no root) --
icon appearance is a personal preference, not a system policy, so it's
implemented as XDG user-level overrides:

  ~/.local/share/applications/<id>.desktop     (full copy of the system
                                                 .desktop, only Icon= changed)
  ~/.local/share/icons/peachos-<style>/*.png   (the curated PNGs)

'dark' is blanket: an app's icon changes only if the repo ships a hand-
authored dark variant for it (assets/app-icons/darkmode/); apps without one
keep their light-mode icon. 'custom' is per-app instead: the Settings app's
Manage Custom Icons page writes CUSTOM_MANIFEST_PATH, and each app there is
independently Default (untouched), Dark (the exact same curated art/render
path as 'dark', just opted into per-app), or Upload (Icon= points straight
at a file the user picked themselves -- no processing, GTK accepts a raw
PNG/SVG as Icon= as-is). peachOS never auto-generates an icon from the
light one for either style -- only real curated art or a real user file.

XDG desktop-file resolution already gives a user's own ~/.local/share
directory priority over /usr/share, so this needs zero coordination with
peachos-icon-watcherd (the system-wide light-mode masking daemon) beyond
peachos_icon_resolve.py knowing to leave these directories alone -- and
critically, the system .desktop files themselves are never touched, which
is what actually caused the real bugs the previous (system-wide, root)
version of this hit: fighting the watcher daemon over the same files, and
GNOME Shell's app-picker-layout state getting corrupted by the resulting
burst of changes to files it watches closely.

'default' mode is just deleting our own override files -- instant, no
image processing needed, since it makes the original system .desktop
(which peachos-icon-watcherd keeps correctly light-mode-masked) visible
again automatically. Switching directly between two non-default styles
(e.g. dark -> custom) does need an explicit reset first, unlike the old
two-blanket-style days -- see main()'s own comment for why.
"""
import concurrent.futures
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from peachos_icon_mask import load_pixbuf_as_pil
from peachos_icon_resolve import resolve_curated_dark, resolve_icon

# Rendering a curated source (rsvg-convert -> a 1024x1024 PIL canvas, most of these SVGs are
# 2000x1500 with an embedded base64-raster mask + feColorMatrix filters -- the real reason a
# style switch used to be visibly heavy) is pure content -> content: the same curated_source
# bytes always produce the exact same PNG. Content-addressed so the FIRST switch to a style
# after a repo update (new/changed curated art) still re-renders exactly what changed, and
# switching back to a style already seen this boot -- the common case -- is a plain file copy.
# Shared across every user account (single-user machine in practice, but content-addressing
# makes that safe regardless) and across repeated switches by the same user; 1777 so any
# unprivileged user can populate/read it, sticky so one user can't unlink another's entry.
CACHE_ROOT = Path('/var/cache/peachos-icon-appearance')


def _cached_render(curated_source, out_path):
    """Copies a cached render of curated_source to out_path if one exists; otherwise renders
    it (the expensive path) and populates the cache for next time. Returns True on success."""
    try:
        digest = hashlib.sha1(curated_source.read_bytes()).hexdigest()
    except OSError:
        digest = None

    cache_path = CACHE_ROOT / f'{digest}.png' if digest else None
    if cache_path is not None and cache_path.exists():
        try:
            shutil.copyfile(cache_path, out_path)
            return True
        except OSError:
            pass  # fall through and render fresh

    img = load_pixbuf_as_pil(str(curated_source))
    img.save(out_path, 'PNG')

    if cache_path is not None:
        try:
            cache_path.parent.mkdir(parents=True, exist_ok=True)
            tmp = cache_path.with_suffix(f'.tmp-{os.getpid()}')
            img.save(tmp, 'PNG')
            tmp.rename(cache_path)  # atomic -- never leaves a torn file another switch reads
            cache_path.chmod(0o644)
        except OSError:
            pass  # cache is a pure optimization -- a write failure just means no speedup next time
    return True

# Flatpak's own export dir added here (it wasn't originally): Calendar/Text Editor/Weather
# etc. only ever exist as Flatpaks, with their REAL desktop file living only here or under a
# per-user override -- neither of which used to be scanned at all, so none of them were ever
# considered a candidate for dark/clear mode, curated or generated, regardless of anything
# in peachos_icon_resolve.py. Real bug this hit: switching to Dark Mode silently did nothing
# for any Flatpak app. Order matters -- see the seen_names loop below.
SYSTEM_DIRS = [
    '/usr/share/applications',
    '/var/lib/snapd/desktop/applications',
    '/var/lib/flatpak/exports/share/applications',
]

USER_APPS_DIR = Path.home() / '.local/share/applications'
USER_ICON_DIR = Path.home() / '.local/share/icons'

# Where the Settings app's Manage Custom Icons page stages uploaded PNG/SVG files and writes
# its per-app choices. Owned entirely by that page -- this script only ever reads it.
CUSTOM_ICONS_DIR = Path.home() / '.local/share/peachos/custom-icons'
CUSTOM_MANIFEST_PATH = CUSTOM_ICONS_DIR / 'manifest.json'

ICON_LINE_RE = re.compile(r'^Icon=(.*)$')
OVERRIDE_MARKER = 'X-PeachOS-AppearanceOverride=true\n'
LEGACY_OVERRIDE_MARKER = 'X-PeachOS-DarkOverride=true\n'  # pre-'clear' marker, still on disk
MAX_WORKERS = 8

# Suffix for a permanent-curation backup -- see _write_override()'s own docstring for why
# this exists.
PERMANENT_BACKUP_SUFFIX = '.peachos-original'


def slug_for(desktop_path):
    stem = re.sub(r'[^A-Za-z0-9_.-]', '_', Path(desktop_path).stem)
    digest = hashlib.sha1(str(desktop_path).encode()).hexdigest()[:8]
    return f'{stem}-{digest}'


def read_meta(desktop_path):
    icon = None
    is_application = False
    no_display = False
    try:
        text = Path(desktop_path).read_text(encoding='utf-8', errors='replace')
    except OSError:
        return None, False, False
    in_entry = False
    for line in text.splitlines():
        if line == '[Desktop Entry]':
            in_entry = True
            continue
        if line.startswith('[') and line != '[Desktop Entry]':
            if in_entry:
                break
            continue
        if not in_entry:
            continue
        if line.startswith('Type=Application'):
            is_application = True
        elif line.startswith('NoDisplay=true'):
            no_display = True
        elif (m := ICON_LINE_RE.match(line)) and icon is None:
            icon = m.group(1).strip()
    return icon, is_application, no_display


def _make_icon(icon_dir, desktop_path, icon):
    """Runs in a worker thread: if the repo ships a hand-authored dark variant of this app's
    icon, render it into the user's icon dir (cached -- see _cached_render). If it doesn't, do
    NOTHING -- the icon is left exactly as light mode had it. peachOS deliberately does not
    synthesize a dark icon from the light one (an algorithm only ever approximates what a
    designer would do, and it needed heavy image deps). No .desktop writes here -- that's the
    main thread."""
    source_path, _category = resolve_icon(icon)
    if source_path is None:
        return None, f'could not resolve icon {icon!r}'

    curated_source = resolve_curated_dark(source_path)
    if curated_source is None:
        return None, None  # no hand-authored variant -- leave this icon as-is

    out_path = icon_dir / f'{slug_for(desktop_path)}.png'
    try:
        _cached_render(curated_source, out_path)
    except Exception as e:
        return None, str(e)
    return out_path, 'curated'


def _write_override(desktop_path, out_path):
    """Writes the styled override to USER_APPS_DIR -- but first, if a file already sits at
    that exact path AND carries neither marker, it's not one of our own prior outputs: it's
    a *permanent* hand-curated override (e.g. Calendar/Text Editor's own iCloud icons, which
    exist as per-user overrides purely to win XDG priority over their Flatpak's own generic
    icon -- see provision.sh/git history). Overwriting that unconditionally, the way this
    used to work, meant apply_default() would later delete it outright (it now carries the
    override marker) with no way back -- the permanent curation was just gone, not restored.
    Snapshotting it once, the first time this ever touches that path, is what apply_default()
    restores from instead of deleting into a gap.
    """
    target = USER_APPS_DIR / desktop_path.name
    backup = target.with_name(target.name + PERMANENT_BACKUP_SUFFIX)
    if target.exists() and not backup.exists():
        try:
            existing = target.read_text(encoding='utf-8', errors='replace')
            if OVERRIDE_MARKER.strip() not in existing and LEGACY_OVERRIDE_MARKER.strip() not in existing:
                backup.write_text(existing, encoding='utf-8')
        except OSError:
            pass  # worst case: no snapshot, falls back to today's delete-on-default behavior

    try:
        lines = desktop_path.read_text(encoding='utf-8', errors='replace').splitlines(keepends=True)
    except OSError as e:
        return f'could not read {desktop_path}: {e}'

    replaced = False
    in_entry = False
    entry_end = len(lines)
    for i, line in enumerate(lines):
        stripped = line.rstrip('\n')
        if stripped == '[Desktop Entry]':
            in_entry = True
            continue
        if stripped.startswith('[') and stripped != '[Desktop Entry]':
            if in_entry:
                entry_end = i
                break
            continue
        if in_entry and ICON_LINE_RE.match(stripped):
            lines[i] = f'Icon={out_path}\n'
            replaced = True
    if not replaced:
        return f'no Icon= line in {desktop_path}'
    lines.insert(entry_end, OVERRIDE_MARKER)

    USER_APPS_DIR.mkdir(parents=True, exist_ok=True)
    target.write_text(''.join(lines), encoding='utf-8')
    return None


def _permanent_curated_icon(desktop_name):
    """If a permanent hand-curated override already sits in USER_APPS_DIR for this exact
    desktop-id (e.g. Calendar/Text Editor's own iCloud icons -- see _write_override()'s own
    docstring for what makes an override "permanent" vs. one of our own prior outputs),
    return ITS Icon= value. Without this, dark/clear mode would resolve the candidate's own
    stock Icon= instead (read from the Flatpak's own export, which _write_override() only
    ever treats as an output target, never consults for input) -- generating a dark version
    of the app's generic stock icon nobody actually sees, instead of the one the user does.
    Real bug this hit: Calendar/Text Editor's dark icons were GNOME's own stock designs,
    not the curated iCloud Calendar/Notes art their light mode actually shows.
    """
    target = USER_APPS_DIR / desktop_name
    try:
        text = target.read_text(encoding='utf-8', errors='replace')
    except OSError:
        return None
    if OVERRIDE_MARKER.strip() in text or LEGACY_OVERRIDE_MARKER.strip() in text:
        return None  # one of our own prior outputs, not a permanent curation -- ignore
    for line in text.splitlines():
        if (m := ICON_LINE_RE.match(line)):
            return m.group(1).strip()
    return None


def _enumerate_candidates():
    """Every real, displayable app across every place peachOS watches, deduped by desktop-id.

    SYSTEM_DIRS is in priority order (matches $XDG_DATA_DIRS): a desktop ID present in more
    than one dir -- e.g. firefox_firefox.desktop and snap-store_snap-store.desktop exist both
    as peachOS's own /usr/share/applications override AND as the original snapd-managed copy
    they shadow at /var/lib/snapd/desktop/applications -- must only ever be processed from its
    highest-priority (first-seen) location. Processing both independently used to race two
    threads against the same output filename, and whichever happened to finish last silently
    won -- sometimes the shadowed original, producing the wrong icon.
    """
    seen_names = set()
    candidates = []
    for d in SYSTEM_DIRS:
        for desktop_path in Path(d).glob('*.desktop'):
            if desktop_path.name in seen_names:
                continue
            icon, is_app, no_display = read_meta(desktop_path)
            if not is_app or no_display or not icon:
                # NOT marked seen here (below the dedup line is the real fix) -- e.g. Text
                # Editor exists both as a NoDisplay'd native apt package (see provision.sh,
                # kept installed only as a base-image dependency) AND the real, curated
                # Flatpak this project actually uses. The old code marked a name seen the
                # moment ANY file with that name was found, even one that fails these
                # checks and was never actually added as a candidate -- so the native
                # entry's own NoDisplay wrongly blocked the real Flatpak entry (checked
                # after it, per SYSTEM_DIRS order) from ever being seen at all.
                continue
            icon = _permanent_curated_icon(desktop_path.name) or icon
            seen_names.add(desktop_path.name)
            candidates.append((desktop_path, icon))
    return candidates


def apply_dark():
    icon_dir = USER_ICON_DIR / 'peachos-dark'
    icon_dir.mkdir(parents=True, exist_ok=True)
    USER_APPS_DIR.mkdir(parents=True, exist_ok=True)

    candidates = _enumerate_candidates()

    with concurrent.futures.ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool:
        futures = {
            pool.submit(_make_icon, icon_dir, dp, icon): (dp, icon)
            for dp, icon in candidates
        }
        for future in concurrent.futures.as_completed(futures):
            desktop_path, icon = futures[future]
            out_path, status = future.result()
            if out_path is None:
                if status:
                    print(f'  ! {desktop_path.name}: {status}')
                continue
            err = _write_override(desktop_path, out_path)
            if err:
                print(f'  ! {desktop_path.name}: {err}')
            else:
                print(f'  dark({status}) {desktop_path.name} -> {out_path}')

    subprocess.run(['update-desktop-database', str(USER_APPS_DIR)], check=False)


def _load_custom_manifest():
    try:
        with open(CUSTOM_MANIFEST_PATH, encoding='utf-8') as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def apply_custom():
    """Per-app manifest written by the Settings app's Manage Custom Icons page -- each
    installed app is independently 'default' (no entry, or that mode explicitly -- left
    untouched, unlike apply_dark() this never regenerates every app unconditionally), 'dark'
    (identical curated art/render path to apply_dark(), just opted into per-app instead of
    blanket), or 'upload' (Icon= points straight at the file the user picked -- no rendering
    at all, GTK accepts a raw PNG/SVG as Icon= as-is)."""
    manifest = _load_custom_manifest()
    if not manifest:
        return  # nothing customized -- every app already shows its default icon

    icon_dir = USER_ICON_DIR / 'peachos-custom'
    icon_dir.mkdir(parents=True, exist_ok=True)
    USER_APPS_DIR.mkdir(parents=True, exist_ok=True)

    candidates = {dp.name: (dp, icon) for dp, icon in _enumerate_candidates()}

    for desktop_id, choice in manifest.items():
        mode = (choice or {}).get('mode')
        if mode not in ('dark', 'upload'):
            continue  # 'default', unknown, or missing -- nothing to override
        entry = candidates.get(desktop_id)
        if entry is None:
            continue  # app no longer installed
        desktop_path, icon = entry

        if mode == 'upload':
            file_name = choice.get('file', '')
            out_path = CUSTOM_ICONS_DIR / file_name
            if not file_name or not out_path.is_file():
                continue
        else:  # 'dark'
            source_path, _category = resolve_icon(icon)
            if source_path is None:
                continue
            curated_source = resolve_curated_dark(source_path)
            if curated_source is None:
                continue  # no dark art for this app -- the manage page wouldn't offer it
            out_path = icon_dir / f'{slug_for(desktop_path)}.png'
            try:
                _cached_render(curated_source, out_path)
            except Exception as e:
                print(f'  ! {desktop_id}: {e}')
                continue

        err = _write_override(desktop_path, out_path)
        if err:
            print(f'  ! {desktop_id}: {err}')
        else:
            print(f'  custom({mode}) {desktop_id} -> {out_path}')

    subprocess.run(['update-desktop-database', str(USER_APPS_DIR)], check=False)


def apply_default():
    if not USER_APPS_DIR.is_dir():
        return
    removed = 0
    restored = 0
    for f in USER_APPS_DIR.glob('*.desktop'):
        try:
            text = f.read_text(encoding='utf-8', errors='replace')
            if OVERRIDE_MARKER.strip() in text or LEGACY_OVERRIDE_MARKER.strip() in text:
                # A permanent hand-curated override (see _write_override()'s own docstring)
                # gets restored, not just deleted into a gap that falls through to whatever
                # generic icon the app itself ships -- that's correct for an app with no
                # permanent curation, but wrong for e.g. Calendar/Text Editor, whose only
                # correct "default" icon IS this file, not their Flatpak's own stock one.
                backup = f.with_name(f.name + PERMANENT_BACKUP_SUFFIX)
                if backup.exists():
                    backup.replace(f)
                    restored += 1
                else:
                    f.unlink()
                    removed += 1
        except OSError:
            continue
    if removed or restored:
        bits = []
        if removed:
            bits.append(f'removed {removed}')
        if restored:
            bits.append(f'restored {restored} permanent curation(s)')
        print(f'  {", ".join(bits)}')
    subprocess.run(['update-desktop-database', str(USER_APPS_DIR)], check=False)


def main():
    styles = ('default', 'dark', 'custom')
    if len(sys.argv) != 2 or sys.argv[1] not in styles:
        print(f'usage: peachos-icon-appearance <{"|".join(styles)}>', file=sys.stderr)
        sys.exit(1)

    style = sys.argv[1]
    if style == 'default':
        apply_default()
        return

    # Reset to a clean slate before layering a non-default style on top. apply_dark()
    # unconditionally regenerates EVERY curated app's override on every run, so it never
    # needed this. apply_custom() doesn't: it only touches apps with an explicit non-default
    # manifest choice, so without this reset first, an app left Dark (or Custom-uploaded) by
    # whichever style was active *before* this switch would keep showing that stale override
    # forever, even after switching away from the style that actually set it.
    apply_default()
    if style == 'dark':
        apply_dark()
    elif style == 'custom':
        apply_custom()


if __name__ == '__main__':
    main()
