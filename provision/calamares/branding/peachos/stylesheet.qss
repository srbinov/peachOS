/*
 * peachOS installer -- black, SF Pro Display, nothing else. Applies to the
 * native Qt-widget step pages (welcome/locale/keyboard/partition/users/summary)
 * and the stock widget sidebar + navigation bar.
 *
 * Only plain Qt widget-class selectors and the three objectNames Calamares
 * documents (#mainApp/#sidebarApp/#logoApp).
 */

#mainApp,
#sidebarApp,
QWidget {
    background-color: #000000;
}

QWidget {
    color: #f5f5f7;
    font-family: "SF Pro Display", "SF Pro Text", "Inter", "Helvetica Neue", sans-serif;
    font-size: 11pt;
    selection-background-color: #0a84ff;
    selection-color: #ffffff;
}

QLabel {
    background-color: transparent;
}

/* Sidebar step list: current step white, the rest dim -- no highlight block. */
#sidebarApp QLabel {
    color: #86868b;
    padding: 3px 0;
}

/* Buttons: flat, quiet, just a thin outline. */
QPushButton {
    background-color: transparent;
    color: #f5f5f7;
    border: 1px solid #48484a;
    border-radius: 8px;
    padding: 6px 18px;
}
QPushButton:hover {
    border-color: #86868b;
}
QPushButton:pressed {
    background-color: #1c1c1e;
}
QPushButton:disabled {
    color: #48484a;
    border-color: #2c2c2e;
}

/* The one filled action: "Install" on the summary page / the default button. */
QPushButton#mainButton,
QPushButton[default="true"] {
    background-color: #0a84ff;
    border: none;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#mainButton:hover,
QPushButton[default="true"]:hover {
    background-color: #3a9dff;
}

QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #1c1c1e;
    color: #f5f5f7;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 5px 10px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #0a84ff;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: #1c1c1e;
    color: #f5f5f7;
    selection-background-color: #0a84ff;
    border: 1px solid #3a3a3c;
}

QRadioButton, QCheckBox {
    background-color: transparent;
    spacing: 8px;
}
QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
}
QRadioButton::indicator:checked {
    background-color: #0a84ff;
    border: 1px solid #0a84ff;
    border-radius: 8px;
}
QRadioButton::indicator:unchecked {
    background-color: transparent;
    border: 1px solid #6e6e73;
    border-radius: 8px;
}
QCheckBox::indicator:checked {
    background-color: #0a84ff;
    border: 1px solid #0a84ff;
    border-radius: 4px;
}
QCheckBox::indicator:unchecked {
    background-color: transparent;
    border: 1px solid #6e6e73;
    border-radius: 4px;
}

QProgressBar {
    background-color: #1c1c1e;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #0a84ff;
    border-radius: 4px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3a3a3c;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3a3a3c;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QListWidget, QTreeView, QTableView {
    background-color: #0d0d0d;
    border: 1px solid #2c2c2e;
    border-radius: 8px;
    alternate-background-color: #141414;
}
QListWidget::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background-color: #0a84ff;
}
