---
componentName: peachos

# Fullscreen so the installer is the only thing on screen -- the live session
# also blanks the desktop and disables every shell extension before this opens
# (see provision/live-session/start-installer.sh).
windowExpanding:    fullscreen

strings:
    productName:         peachOS
    shortProductName:    peachOS
    version:             10.0
    shortVersion:        10.0
    versionedName:       peachOS 10.0
    shortVersionedName:  peachOS 10.0
    bootloaderEntryName: peachOS
    productUrl:          https://github.com/srbinov/peachOS
    supportUrl:          https://github.com/srbinov/peachOS/issues

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"

slideshow:               "show.qml"
slideshowAPI:            1

# Stock Calamares chrome: the plain widget step-list on the left and a plain
# Back/Next button bar. No custom QML panels -- keep it simple.
sidebar: widget
navigation: widget

# Pure black surfaces, no accent bar on the sidebar -- the current step is just
# white text, the rest dim grey.
style:
   sidebarBackground:         "#000000"
   sidebarText:               "#86868b"
   sidebarTextSelect:         "#ffffff"
   sidebarBackgroundSelected: "#000000"
